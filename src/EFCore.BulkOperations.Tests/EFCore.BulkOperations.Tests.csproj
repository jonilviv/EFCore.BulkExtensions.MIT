<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\EFCore.BulkOperations.props" />

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA2007;EF1002;CS0105;xUnit1051;xUnit1030;xUnit2029</NoWarn>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <DefineConstants>$(DefineConstants);V8</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <DefineConstants>$(DefineConstants);V10</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EFCore.BulkOperations\EFCore.BulkOperations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="testsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="testsettings.docker.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Import Project="..\targets\coverlet.collector.targets" />
  <Import Project="..\targets\Microsoft.Extensions.Configuration.Json.targets" />
  <Import Project="..\targets\Microsoft.NET.Test.Sdk.targets" />
  <Import Project="..\targets\RT.Comb.targets" />
  <Import Project="..\targets\xunit.v3.targets" />
  <Import Project="..\targets\xunit.runner.visualstudio.targets" />

</Project>